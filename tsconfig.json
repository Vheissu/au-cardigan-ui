{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "baseUrl": "src",
    "declaration": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "lib": ["esnext", "dom"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true
  },
  "include": [
    "./src/**/*.ts",
    "./types/**/*.d.ts"
  ]
}
